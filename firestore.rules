rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each student can only read/write their own results document
    match /results/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users collection: students can write their own entry; admin can read all
    match /users/{userId} {
      // A student can read & update their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Admin can read all user docs (for leaderboard)
      // Replace ADMIN_UID_HERE with your actual admin UID
      allow read: if request.auth != null && request.auth.uid == "PASTE_YOUR_ADMIN_UID_HERE";
    }
  }
}
